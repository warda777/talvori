@startuml Learn Mode Flow

title Learn Mode - Deck Building & Review Flow

skinparam backgroundColor #FFFFFF
skinparam activity {
    BackgroundColor #E8F4F8
    BorderColor #2E86AB
    FontColor #000000
}

skinparam note {
    BackgroundColor #FFF9E6
    BorderColor #FFA500
}

start

:Learn Mode Start;

partition "Initialisierung" {
    :init() aufgerufen;
    :_loadStageData();
    note right: Lädt CategoryProgress\naus Backend
    :_loadWords();
    note right: Lädt Wörter basierend\nauf SRS-Mode
}

partition "Deck Building" {
    if (SRS == A-SRS?) then (ja)
        :fetchLearnQueueAdaptive();
        note right: RPC: fn_user_learn_queue_adaptive\nAlle Wörter ohne Deckelung
        :finalIds = queue.map(w => w.id);
        :finalShuffledIds = finalIds;
        :_rebuildStageQueuesFromCurrentWords();
        :_ensureValidActiveStageAndSync();
    else (nein - T-SRS/Hybrid)
        :fetchLearnQueueForMode();
        note right: RPC: fetch_learn_queue_for_mode\nMit Stage-Filter
        :_buildQueueDueFirst();
        note right: Due-First Sortierung
        :_buildDeckIdsWithQuota();
        note right: Quota: S0=35%, S1=20%,\nS2=20%, S3=15%, S4=7%, S5=3%
        :finalShuffledIds = stageWordIds || finalIds;
    endif
    
    :wordQueue = queue;
    :shuffledWordIds = finalShuffledIds;
    :index = 0;
}

partition "Review Flow" {
    :User swiped card;
    :_handleAnswer(correct: bool);
    
    if (Mode == Single?) then (ja)
        :singleMove();
        :singleNextWordId();
        stop
    endif
    
    if (Mode == S1-S5?) then (ja)
        :oldStage aus DB holen;
        :submitReview();
        :Lokales Stage-Update;
        stop
    endif
    
    ' S0-S5 Flow
    :oldStage aus DB holen;
    note right: user_word_srs\nmit mode-Filter
    
    if (SRS == A-SRS?) then (ja)
        :Keine lokale Stage-Mutation;
    else (T-SRS/Hybrid)
        :Lokale Stage-Schätzung;
        :Queue-Item updaten;
    endif
    
    :submitReview();
    note right: RPC: fn_user_review_mode\noder fn_user_review_time_mode
    
    :Lokales Progress-Update;
    note right: stages[oldStage] -= 1\nstages[serverStage] += 1
    
    if (isRequeue?) then (ja)
        :requeueConsume();
        note right: RPC: fn_user_requeue_consume
    endif
}

partition "Navigation" {
    if (SRS == A-SRS?) then (ja)
        :_moveWordIdQueue();
        note right: Verschiebt Word-ID\nzwischen _stageQueues
        if (activeStage changed?) then (ja)
            :_syncDeckToActiveStage(shuffle: true);
            note right: Deck aus\n_stageQueues[activeStage]
        else (nein)
            :_advanceIndexAfterReview(fromIndex);
        endif
    else (T-SRS/Hybrid)
        :_advanceIndexAfterReview(fromIndex);
    endif
}

partition "Deck-Ende Handling" {
    :_advanceIndexAfterReview();
    
    if (nextIndex >= deckLen?) then (ja)
        :🏁 Deck finished;
        :_buildNextDeckIds();
        
        if (SRS == A-SRS?) then (ja)
            :IDs aus _stageQueues[activeStage];
            :Shuffle;
        else (T-SRS/Hybrid)
            :Filter wordQueue nach allowed stages;
            :_buildQueueDueFirst();
            :_buildDeckIdsWithQuota();
        endif
        
        if (newIds.isEmpty?) then (ja)
            :Session beenden;
            stop
        else (nein)
            :shuffledWordIds = newIds;
            :index = 0;
            :deckStages neu berechnen;
        endif
    else (nein)
        :index = nextIndex;
    endif
}

:Zeige nächste Karte;

stop

note right
**Due-Regeln:**
- A-SRS: nextDueAt == null → immer due
- T-SRS/Hybrid: nextDueAt == null && stage == 0 → due
- T-SRS/Hybrid: nextDueAt == null && stage > 0 → nicht due
- nextDueAt != null && nextDueAt <= now → due
end note

note right
**A-SRS Stage-Queues:**
- _stageQueues[0..5]: Word-IDs pro Stage
- Wird nach jedem Review aktualisiert
- _syncDeckToActiveStage() baut Deck daraus
end note

note right
**Quota-Verteilung (T-SRS/Hybrid):**
- S0: 35%
- S1: 20%
- S2: 20%
- S3: 15%
- S4: 7%
- S5: 3%
- Interleave: Round-Robin
- Max Deck-Size: 200 Karten
end note

@enduml

